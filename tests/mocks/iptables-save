#!/bin/bash
# Test double for iptables-save. Emits a minimal but structurally valid dump.
# fiero-hotspot.sh gates its snapshot on the first line matching
# '^# Generated by', so the header must be present or the rollback is skipped.
M=/tmp/mock-state
echo "iptables-save $*" >>"$M/events"
cat <<'EOF'
# Generated by iptables-save v1.8.9 (nf_tables) on fiero-test
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
-A INPUT -p udp --dport 53 -j ACCEPT
-A FORWARD -i ap0 -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
COMMIT
EOF
exit 0
