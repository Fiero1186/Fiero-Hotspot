[Unit]
Description=Fiero Auto Hotspot
After=network.target NetworkManager.service
Wants=network.target
# A crash is worth another try; a dead upstream or a missing interface is not
# (exit 75, see monitor_hotspot). Bounded so a persistent fault cannot loop.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
SyslogIdentifier=fiero-hotspot
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/fiero-hotspot start
ExecStop=/usr/local/bin/fiero-hotspot stop
TimeoutStopSec=60s
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=75

# /run/fiero-hotspot (mode 0755) holds the create_ap config file (with the
# passphrase), the create_ap PID, the AP interface name, and the state/event
# IPC files that the unprivileged watcher in fiero-prompt.sh reads. systemd
# creates it on start and removes it on stop. Secrets are protected by their
# own 0600 file modes (write_create_ap_config uses umask 077), not by the
# directory mode.
RuntimeDirectory=fiero-hotspot
RuntimeDirectoryMode=0755

# Hardening
# ProtectSystem=strict makes the whole filesystem read-only. /tmp is only
# writable when PrivateTmp=true, and create_ap needs it for
# `mktemp -d /tmp/create_ap.*`. The private /tmp is also wiped automatically
# when the service stops, so no stale create_ap directories survive a crash.
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only locks /home and /root.
ProtectHome=read-only
# create_ap writes unmanaged-devices= into NetworkManager.conf so that
# NetworkManager leaves the virtual AP interface alone. The "-" prefix keeps
# the unit working on systems without /etc/NetworkManager.
ReadWritePaths=/run /var/log -/etc/NetworkManager
RestrictNamespaces=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
NoNewPrivileges=true
LockPersonality=true
ProtectHostname=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ProtectControlGroups=true
SystemCallFilter=~@clock @debug @module @mount @obsolete @cpu-emulation @raw-io @reboot @swap

# Intentionally omitted hardening directives:
# - ProtectKernelTunables=true: blocks create_ap from writing net.ipv4.ip_forward
# See README.md "Systemd Hardening Rationale" for architectural justification.

# Capabilities required for NAT routing (iptables, hostapd) and dnsmasq
# (bind :53/:67). Desktop notifications are emitted by the unprivileged
# watcher in fiero-prompt.sh reading /run/fiero-hotspot/events, so no kill
# or audit capabilities are needed here.
#
# CAP_SETGID/CAP_SETUID are retained solely because dnsmasq drops to the
# 'nobody' group/user. Without them dnsmasq aborts at startup with
# "failed to change group-id to nobody: Operation not permitted" and
# create_ap tears the AP down. Nothing in fiero-hotspot itself uses them.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

