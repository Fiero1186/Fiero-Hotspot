[Unit]
Description=Fiero Auto Hotspot
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
PrivateTmp=true
SyslogIdentifier=fiero-hotspot
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/fiero-hotspot start
ExecStop=/usr/local/bin/fiero-hotspot stop
TimeoutStopSec=30s
Restart=no

# Hardening
# ProtectHome=read-only locks /home and /root; D-Bus session socket access
# under /run/user/$UID/bus is restored via ReadWritePaths=/run.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run /var/log
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target

# END OF FILE
