[Unit]
Description=Fiero Auto Hotspot
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
PrivateTmp=false
SyslogIdentifier=fiero-hotspot
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/fiero-hotspot start
ExecStop=/usr/local/bin/fiero-hotspot stop
TimeoutStopSec=30s
Restart=no

# Hardening
# ProtectHome=read-only locks /home and /root; D-Bus session socket access
# under /run/user/$UID/bus is restored via ReadWritePaths=/run.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run /var/log /proc/sys/net/ipv4
RestrictNamespaces=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectHostname=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ProtectControlGroups=true
RestrictRealtime=true
SystemCallFilter=~@clock @debug @module @mount @obsolete @cpu-emulation @raw-io @reboot @swap

# Intentionally omitted hardening directives:
# - NoNewPrivileges=true: breaks PAM session for sudo -u $TARGET_USER notify-send
# - ProtectKernelTunables=true: blocks create_ap from writing net.ipv4.ip_forward
# See README.md "Systemd Hardening Rationale" for architectural justification.

# Capabilities required for NAT routing and PAM session privilege dropping
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_OVERRIDE CAP_AUDIT_WRITE

[Install]
WantedBy=multi-user.target

# END OF FILE
