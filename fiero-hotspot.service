[Unit]
Description=Fiero Auto Hotspot
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
SyslogIdentifier=fiero-hotspot
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/fiero-hotspot start
ExecStop=/usr/local/bin/fiero-hotspot stop
TimeoutStopSec=30s
Restart=no

# /run/fiero-hotspot (mode 0700) holds the create_ap config file (with the
# passphrase), the create_ap PID and the AP interface name. systemd creates it
# on start and removes it on stop.
RuntimeDirectory=fiero-hotspot
RuntimeDirectoryMode=0700

# Hardening
# ProtectSystem=strict makes the whole filesystem read-only. /tmp is only
# writable when PrivateTmp=true, and create_ap needs it for
# `mktemp -d /tmp/create_ap.*`. The private /tmp is also wiped automatically
# when the service stops, so no stale create_ap directories survive a crash.
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only locks /home and /root; D-Bus session socket access
# under /run/user/$UID/bus is restored via ReadWritePaths=/run.
ProtectHome=read-only
# create_ap writes unmanaged-devices= into NetworkManager.conf so that
# NetworkManager leaves the virtual AP interface alone. The "-" prefix keeps
# the unit working on systems without /etc/NetworkManager.
ReadWritePaths=/run /var/log /proc/sys/net/ipv4 -/etc/NetworkManager
RestrictNamespaces=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectHostname=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
ProtectControlGroups=true
SystemCallFilter=~@clock @debug @module @mount @obsolete @cpu-emulation @raw-io @reboot @swap

# Intentionally omitted hardening directives:
# - NoNewPrivileges=true: breaks PAM session for sudo -u $TARGET_USER notify-send
# - RestrictRealtime=true: conflicts with PAM limits applied by sudo for the target user
# - ProtectKernelTunables=true: blocks create_ap from writing net.ipv4.ip_forward
# See README.md "Systemd Hardening Rationale" for architectural justification.

# Capabilities required for NAT routing (iptables, hostapd), dnsmasq
# (bind :53/:67, drop to nobody, chown lease/pid files) and the PAM session
# opened by `sudo -u $TARGET_USER notify-send` (pam_limits needs
# CAP_SYS_RESOURCE, pam_loginuid/audit needs CAP_AUDIT_WRITE).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE CAP_CHOWN CAP_AUDIT_WRITE CAP_KILL CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target

