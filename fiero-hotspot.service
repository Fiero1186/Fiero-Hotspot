[Unit]
Description=Fiero Auto Hotspot
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
PrivateTmp=true
SyslogIdentifier=fiero-hotspot
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/fiero-hotspot start
ExecStop=/usr/local/bin/fiero-hotspot stop
TimeoutStopSec=30s
Restart=no

# Hardening
# ProtectHome=read-only locks /home and /root; D-Bus session socket access
# under /run/user/$UID/bus is restored via ReadWritePaths=/run.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run /var/log /proc/sys/net/ipv4
RestrictNamespaces=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectHostname=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

# Capabilities required for NAT routing, dnsmasq chown, and PAM session privilege dropping
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE CAP_CHOWN CAP_AUDIT_WRITE CAP_KILL CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target

# END OF FILE
